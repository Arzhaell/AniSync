<?xml version="1.0" encoding="utf-8"?>
<!-- English strings of the AniSync installer (default; French in AniSyncTheme.fr.wxl). Ids from the standard WiX theme. -->
<WixLocalization Culture="en-US" Language="1033" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="AniSync Setup" />
  <String Id="Title" Value="AniSync" />
  <String Id="InstallTitle" Value="Install AniSync" />
  <String Id="CheckingForUpdatesLabel" Value="Checking for updates…" />
  <String Id="UpdateButton" Value="&amp;Update to version [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Your AniList or MyAnimeList list, up to date" />
  <String Id="InstallMessage" Value="AniSync spots the anime you're watching on this PC and updates your AniList or MyAnimeList list once you've really finished an episode.&#xA;&#xA;•  For your account only, no admin rights needed&#xA;•  Starts with Windows, sits quietly by the clock&#xA;•  The &quot;Listening&quot; switch turns it all off at any time&#xA;•  Only the title and your progress go online" />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Are you sure you want to cancel?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Previous version" />
  <String Id="HelpHeader" Value="Setup help" />
  <String Id="HelpText" Value="/install | /uninstall | /layout [folder]: installs, uninstalls or copies the full installer to a folder. Default: install.&#xA;&#xA;/passive | /quiet: minimal UI with no prompts, or no UI at all.&#xA;&#xA;/norestart: never restart.&#xA;/log log.txt: writes the log to this file (default: in %TEMP%)." />
  <String Id="HelpCloseButton" Value="&amp;Close" />
  <String Id="InstallLicenseLinkText" Value="AniSync &lt;a href=&quot;#&quot;&gt;terms of use&lt;/a&gt;" />
  <String Id="InstallAcceptCheckbox" Value="I &amp;agree to the terms of use" />
  <String Id="InstallOptionsButton" Value="&amp;Options" />
  <String Id="InstallInstallButton" Value="&amp;Install" />
  <String Id="InstallCancelButton" Value="Cancel" />
  <String Id="OptionsHeader" Value="Setup options" />
  <String Id="OptionsLocationLabel" Value="Install folder:" />
  <String Id="OptionsBrowseButton" Value="&amp;Browse" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="Cancel" />
  <String Id="ProgressHeader" Value="Installing…" />
  <String Id="ProgressLabel" Value="Step:" />
  <String Id="OverallProgressPackageText" Value="Getting ready…" />
  <String Id="ProgressCancelButton" Value="Cancel" />
  <String Id="ModifyHeader" Value="AniSync is already installed" />
  <String Id="ModifyMessage" Value="You can uninstall it, or just close this window.&#xA;&#xA;To install a new version, simply run the new installer: the update happens on its own." />
  <String Id="ModifyRepairButton" Value="&amp;Repair" />
  <String Id="ModifyUninstallButton" Value="&amp;Uninstall" />
  <String Id="ModifyCancelButton" Value="Close" />
  <String Id="SuccessHeader" Value="Done" />
  <String Id="SuccessCacheHeader" Value="Done" />
  <String Id="SuccessInstallHeader" Value="AniSync is installed!" />
  <String Id="SuccessLayoutHeader" Value="Copy complete" />
  <String Id="SuccessModifyHeader" Value="Change complete" />
  <String Id="SuccessRepairHeader" Value="Repair complete" />
  <String Id="SuccessUninstallHeader" Value="AniSync has been uninstalled" />
  <String Id="SuccessUnsafeUninstallHeader" Value="AniSync has been uninstalled" />
  <String Id="SuccessInstallMessage" Value="It will also start automatically with Windows (you can turn that off in the app).&#xA;&#xA;First step: click &quot;Add an account&quot; in the app (AniList or MyAnimeList). Then play an episode, AniSync takes care of the rest." />
  <String Id="SuccessUninstallMessage" Value="The app, its shortcuts and the start with Windows have been removed.&#xA;&#xA;Your settings stay in %APPDATA%\AniSync in case you reinstall it." />
  <String Id="SuccessLaunchButton" Value="&amp;Launch AniSync" />
  <String Id="SuccessRestartText" Value="You must restart your computer to finish the installation." />
  <String Id="SuccessUninstallRestartText" Value="You must restart your computer to finish the uninstallation." />
  <String Id="SuccessRestartButton" Value="&amp;Restart" />
  <String Id="SuccessCloseButton" Value="&amp;Close" />
  <String Id="FailureHeader" Value="Setup failed" />
  <String Id="FailureCacheHeader" Value="The operation failed" />
  <String Id="FailureInstallHeader" Value="Setup failed" />
  <String Id="FailureLayoutHeader" Value="The copy failed" />
  <String Id="FailureModifyHeader" Value="The change failed" />
  <String Id="FailureRepairHeader" Value="The repair failed" />
  <String Id="FailureUninstallHeader" Value="Uninstall failed" />
  <String Id="FailureUnsafeUninstallHeader" Value="Uninstall failed" />
  <String Id="FailureHyperlinkLogText" Value="A problem stopped the operation from completing. For details, open the &lt;a href=&quot;#&quot;&gt;setup log&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="You must restart your computer to finish rolling back." />
  <String Id="FailureRestartButton" Value="&amp;Restart" />
  <String Id="FailureCloseButton" Value="&amp;Close" />
  <String Id="FilesInUseTitle" Value="Files in use" />
  <String Id="FilesInUseLabel" Value="These applications are using files that need to be updated:" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="Close the &amp;applications." />
  <String Id="FilesInUseCloseRadioButton" Value="Close the &amp;applications and try to restart them." />
  <String Id="FilesInUseDontCloseRadioButton" Value="&amp;Do not close the applications (a restart will be required)." />
  <String Id="FilesInUseRetryButton" Value="&amp;Retry" />
  <String Id="FilesInUseIgnoreButton" Value="&amp;Ignore" />
  <String Id="FilesInUseExitButton" Value="E&amp;xit" />
</WixLocalization>
