<?xml version="1.0" encoding="utf-8"?>
<!-- Textes français de l'installeur AniSync (identifiants du thème standard WiX). -->
<WixLocalization Culture="fr-FR" Language="1036" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Installation d'AniSync" />
  <String Id="Title" Value="AniSync" />
  <String Id="InstallTitle" Value="Installer AniSync" />
  <String Id="CheckingForUpdatesLabel" Value="Recherche de mises à jour…" />
  <String Id="UpdateButton" Value="&amp;Mettre à jour vers la version [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Ta liste AniList ou MyAnimeList à jour" />
  <String Id="InstallMessage" Value="AniSync repère l'anime que tu regardes sur ce PC et met ta liste AniList ou MyAnimeList à jour quand tu as vraiment fini un épisode.&#xA;&#xA;•  Pour ton compte seulement, sans droits admin&#xA;•  Démarre avec Windows, discret près de l'horloge&#xA;•  Le bouton « Écoute » coupe tout à tout moment&#xA;•  Seuls le titre et ta progression partent en ligne" />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Veux-tu vraiment annuler ?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Version précédente" />
  <String Id="HelpHeader" Value="Aide de l'installeur" />
  <String Id="HelpText" Value="/install | /uninstall | /layout [dossier] : installe, désinstalle ou copie l'installeur complet dans un dossier. Par défaut : installation.&#xA;&#xA;/passive | /quiet : interface minimale sans question, ou aucune interface.&#xA;&#xA;/norestart : ne jamais redémarrer.&#xA;/log fichier.txt : journal dans ce fichier (par défaut dans %TEMP%)." />
  <String Id="HelpCloseButton" Value="&amp;Fermer" />
  <String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Conditions d'utilisation&lt;/a&gt; d'AniSync" />
  <String Id="InstallAcceptCheckbox" Value="J'&amp;accepte les conditions d'utilisation" />
  <String Id="InstallOptionsButton" Value="&amp;Options" />
  <String Id="InstallInstallButton" Value="&amp;Installer" />
  <String Id="InstallCancelButton" Value="Annuler" />
  <String Id="OptionsHeader" Value="Options d'installation" />
  <String Id="OptionsLocationLabel" Value="Dossier d'installation :" />
  <String Id="OptionsBrowseButton" Value="&amp;Parcourir" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="Annuler" />
  <String Id="ProgressHeader" Value="Installation en cours…" />
  <String Id="ProgressLabel" Value="Étape :" />
  <String Id="OverallProgressPackageText" Value="Préparation…" />
  <String Id="ProgressCancelButton" Value="Annuler" />
  <String Id="ModifyHeader" Value="AniSync est déjà installé" />
  <String Id="ModifyMessage" Value="Tu peux le désinstaller, ou simplement fermer cette fenêtre.&#xA;&#xA;Pour installer une nouvelle version, lance directement le nouvel installeur : la mise à jour se fait toute seule." />
  <String Id="ModifyRepairButton" Value="&amp;Réparer" />
  <String Id="ModifyUninstallButton" Value="&amp;Désinstaller" />
  <String Id="ModifyCancelButton" Value="Fermer" />
  <String Id="SuccessHeader" Value="Terminé" />
  <String Id="SuccessCacheHeader" Value="Terminé" />
  <String Id="SuccessInstallHeader" Value="AniSync est installé !" />
  <String Id="SuccessLayoutHeader" Value="Copie terminée" />
  <String Id="SuccessModifyHeader" Value="Modification terminée" />
  <String Id="SuccessRepairHeader" Value="Réparation terminée" />
  <String Id="SuccessUninstallHeader" Value="AniSync a été désinstallé" />
  <String Id="SuccessUnsafeUninstallHeader" Value="AniSync a été désinstallé" />
  <String Id="SuccessInstallMessage" Value="Il démarrera aussi automatiquement avec Windows (désactivable dans l'appli).&#xA;&#xA;Première étape : clique sur « Ajouter un compte » dans l'appli (AniList ou MyAnimeList). Ensuite, lance un épisode, AniSync s'occupe du reste." />
  <String Id="SuccessUninstallMessage" Value="L'appli, ses raccourcis et le lancement avec Windows ont été retirés.&#xA;&#xA;Tes réglages restent dans %APPDATA%\AniSync au cas où tu le réinstallerais." />
  <String Id="SuccessLaunchButton" Value="&amp;Lancer AniSync" />
  <String Id="SuccessRestartText" Value="Tu dois redémarrer ton ordinateur pour terminer l'installation." />
  <String Id="SuccessUninstallRestartText" Value="Tu dois redémarrer ton ordinateur pour terminer la désinstallation." />
  <String Id="SuccessRestartButton" Value="&amp;Redémarrer" />
  <String Id="SuccessCloseButton" Value="&amp;Fermer" />
