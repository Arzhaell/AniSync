<Window x:Class="AniSync.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AniSync.Ui"
        Title="Connexion" Icon="Assets/AniSync.ico"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <StackPanel Margin="22,20,22,20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="Step1Text" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,130,0"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource BaseButton}" Content="{x:Static ui:Tr.OpenPage}" Click="OpenDeveloper_Click"/>
                </Grid>

                <TextBlock x:Name="Step2Text" TextWrapping="Wrap" Margin="0,14,0,6"/>
                <Grid>
                    <TextBox x:Name="RedirectBox" IsReadOnly="True" Margin="0,0,86,0" FontFamily="Consolas"/>
                    <Button HorizontalAlignment="Right" Width="78" Style="{StaticResource BaseButton}" Content="{x:Static ui:Tr.Copy}" Click="CopyRedirect_Click"/>
                </Grid>

                <TextBlock x:Name="Step3Text" TextWrapping="Wrap" Margin="0,14,0,6"/>
                <TextBox x:Name="ClientIdBox" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="2,14,2,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{x:Static ui:Tr.Cancel}" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="ConnectButton" Style="{StaticResource AccentButton}" Content="{x:Static ui:Tr.SignIn}" Margin="8,0,0,0"
                    Padding="16,8" Click="Connect_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
