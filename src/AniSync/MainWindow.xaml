<Window x:Class="AniSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AniSync" Icon="Assets/AniSync.ico"
        Width="470" Height="760" MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête : nom de l'appli + compte AniList -->
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AniSync" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Synchro AniList &amp; MyAnimeList" Style="{StaticResource Muted}"/>
            </StackPanel>

            <!-- Compte actif : avatar/nom = page du profil sur le site ; flèche = fenêtre Comptes -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource GhostButton}" Padding="6,4" Click="OpenProfile_Click"
                        AutomationProperties.Name="Profil" ToolTip="Ouvrir mon profil sur le site">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="{StaticResource SubtleBrush}"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AccountCaption}" Style="{StaticResource Caption}" Foreground="{Binding AccountCaptionColor}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="8,10" Click="Accounts_Click"
                        AutomationProperties.Name="Comptes" ToolTip="Changer de compte, en ajouter ou en retirer">
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11"/>
                </Button>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButton}"
                    Click="Accounts_Click" Content="Ajouter un compte"
                    Visibility="{Binding HasProfile, Converter={StaticResource InvBoolToVis}}"/>
        </Grid>

        <!-- Le bouton Écoute -->
        <ToggleButton Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource ListenToggle}"
                      IsChecked="{Binding Listening, Mode=TwoWay}" ToolTip="Activer / désactiver l'écoute du PC"/>

        <!-- Zone centrale défilante : « En cours » puis l'historique -->
        <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="0,14,-8,0" Padding="0,0,8,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <!-- En cours -->
        <Border Style="{StaticResource Card}" MinHeight="128">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"
                            Visibility="{Binding HasCurrent, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding EmptyText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <Grid Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="76" Height="108" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="{StaticResource SubtleBrush}">
                            <TextBlock Text="&#xE8B2;" Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPlaying}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CurrentSource}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Cursor="Hand" MouseLeftButtonUp="CurrentTitle_Click" ToolTip="Ouvrir la fiche de l'anime"/>
                        <TextBlock Text="{Binding CurrentEpisode}" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}" Margin="0,10,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding CurrentTime}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding CurrentList}" Foreground="{Binding CurrentListColor}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- Titre non reconnu avec certitude : animes ressemblants à valider d'un clic -->
                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0"
                                      Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F1A28" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="42" CornerRadius="4" Background="{StaticResource SubtleBrush}">
                                                <Border CornerRadius="4">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="C'est lui" Padding="10,5"
                                                    VerticalAlignment="Center" Tag="{Binding}" Click="ConfirmSuggestion_Click"
                                                    ToolTip="Associer ce titre à cet anime (retenu pour les prochains épisodes)"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource BaseButton}" Click="FixCurrent_Click" AutomationProperties.Name="Corriger"
                                    ToolTip="Ce n'est pas le bon anime ? Choisis le bon">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Corriger"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="IgnoreCurrent_Click" Margin="6,0,0,0"
                                    ToolTip="Ne plus jamais suivre ce titre" Content="Ignorer ce titre"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Historique -->
        <StackPanel Margin="0,18,0,0">
            <TextBlock Text="Historique" FontSize="15" FontWeight="SemiBold"/>

            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Rien pour l'instant. Chaque épisode terminé apparaîtra ici, avec la possibilité d'annuler."
                       Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding History}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{Binding Color}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding DisplayMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource BaseButton}" Content="Annuler" Tag="{Binding}" Click="Undo_Click"
                                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Remettre ta liste comme avant"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Oui" Tag="{Binding}" Click="ConfirmHistory_Click"
                                                Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}"
                                                ToolTip="C'est bien cet anime : l'associer et synchroniser" Margin="0,0,0,4"/>
                                        <Button Style="{StaticResource BaseButton}" Content="Autre…" Tag="{Binding}" Click="FixHistory_Click"
                                                Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Ce n'est pas lui : choisir un autre anime"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Corriger" Tag="{Binding}" Click="FixHistory_Click"
                                                Visibility="{Binding CanFixOnly, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Choisir le bon anime et synchroniser"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Ignorer" Tag="{Binding}" Click="IgnoreHistory_Click"
                                                Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Ce n'est pas un anime : ne plus suivre ce titre" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- Réglages -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Temps minimum pour compter un épisode" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"
                                   Text="Lecture réelle, pauses exclues (85 % de la durée pour les épisodes courts)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BaseButton}" Padding="9,4" Content="−" Click="MinusMinutes_Click"/>
                        <TextBlock Width="46" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                            <Run Text="{Binding MinWatchMinutes, Mode=OneWay}"/><Run Text=" min"/>
                        </TextBlock>
                        <Button Style="{StaticResource BaseButton}" Padding="9,4" Content="+" Click="PlusMinutes_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Extension navigateur (Crunchyroll, Opera, Edge…)" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding ExtensionStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ExtensionStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="Installer…" VerticalAlignment="Center"
                            Click="InstallExtension_Click" ToolTip="Installer l'extension dans Opera ou Edge"/>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <CheckBox Content="Lancer avec Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,18,4"/>
                    <CheckBox Content="Notifications" IsChecked="{Binding Notifications}" Margin="0,0,18,4"/>
                    <Button Style="{StaticResource GhostButton}" Padding="0,0" Click="ClearIgnored_Click"
                            Visibility="{Binding HasIgnored, Converter={StaticResource BoolToVis}}">
                        <TextBlock>
                            <Run Text="Réactiver les titres ignorés ("/><Run Text="{Binding IgnoredCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
