<Window x:Class="AniSync.ExtensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extension navigateur" Icon="Assets/AniSync.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <StackPanel Margin="22,20,22,20">
        <TextBlock Text="Installer l'extension navigateur" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"
                   Text="Elle lit directement dans la page l'anime, la saison et l'épisode (indispensable pour Crunchyroll, qui ne les affiche pas dans l'onglet), puis les transmet à AniSync sur ce PC. Hors navigateur, AniSync continue de détecter comme avant."/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="1." FontWeight="SemiBold"/> Le dossier de l'extension est prêt :
                </TextBlock>
                <Grid Margin="0,6,0,0">
                    <TextBox x:Name="FolderBox" IsReadOnly="True" Margin="0,0,176,0" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BaseButton}" Content="Copier" Width="80" Click="CopyFolder_Click"/>
                        <Button Style="{StaticResource BaseButton}" Content="Ouvrir" Width="80" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,14,0,0">
                    <Run Text="2." FontWeight="SemiBold"/> Dans ton navigateur, tape dans la barre d'adresse :
                </TextBlock>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BaseButton}" Margin="0,0,4,0" Click="CopyOpera_Click" ToolTip="Copier l'adresse">
                        <TextBlock><Run Text="Opera : "/><Run Text="opera://extensions" FontFamily="Consolas"/></TextBlock>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource BaseButton}" Margin="4,0,0,0" Click="CopyEdge_Click" ToolTip="Copier l'adresse">
                        <TextBlock><Run Text="Edge : "/><Run Text="edge://extensions" FontFamily="Consolas"/></TextBlock>
                    </Button>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,14,0,0">
                    <Run Text="3." FontWeight="SemiBold"/> Active le <Run Text="Mode développeur" FontWeight="SemiBold"/> (interrupteur en haut à droite, ou à gauche dans Edge).
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="4." FontWeight="SemiBold"/> Clique sur <Run Text="Charger l'extension non empaquetée" FontWeight="SemiBold"/> et choisis le dossier de l'étape 1.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="5." FontWeight="SemiBold"/> Lance un épisode : l'état ci-dessous passe au vert.
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
            <Ellipse Width="8" Height="8" Fill="{Binding ExtensionStatusColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ExtensionStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="CopiedText" Style="{StaticResource Muted}" Margin="2,6,0,0" Visibility="Collapsed"/>

        <Button HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Content="Terminé" Padding="18,8" Margin="0,16,0,0"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
