<Window x:Class="AniSync.ExtensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AniSync.Ui"
        Title="{x:Static ui:Tr.ExtensionWindowTitle}" Icon="Assets/AniSync.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <StackPanel Margin="22,20,22,20">
        <TextBlock Text="{x:Static ui:Tr.ExtensionHeading}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16" Text="{x:Static ui:Tr.ExtensionIntro}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="1." FontWeight="SemiBold"/>
                    <Run Text="{x:Static ui:Tr.ExtensionStep1}"/>
                </TextBlock>
                <Grid Margin="0,6,0,0">
                    <TextBox x:Name="FolderBox" IsReadOnly="True" Margin="0,0,176,0" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BaseButton}" Content="{x:Static ui:Tr.Copy}" Width="80" Click="CopyFolder_Click"/>
                        <Button Style="{StaticResource BaseButton}" Content="{x:Static ui:Tr.Open}" Width="80" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,14,0,0">
                    <Run Text="2." FontWeight="SemiBold"/>
                    <Run Text="{x:Static ui:Tr.ExtensionStep2}"/>
                </TextBlock>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BaseButton}" Margin="0,0,4,0" Click="CopyOpera_Click" ToolTip="{x:Static ui:Tr.CopyAddressTip}">
                        <TextBlock><Run Text="Opera: "/><Run Text="opera://extensions" FontFamily="Consolas"/></TextBlock>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource BaseButton}" Margin="4,0,0,0" Click="CopyEdge_Click" ToolTip="{x:Static ui:Tr.CopyAddressTip}">
                        <TextBlock><Run Text="Edge: "/><Run Text="edge://extensions" FontFamily="Consolas"/></TextBlock>
                    </Button>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,14,0,0">
                    <Run Text="3." FontWeight="SemiBold"/>
                    <Run Text="{x:Static ui:Tr.ExtensionStep3}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="4." FontWeight="SemiBold"/>
                    <Run Text="{x:Static ui:Tr.ExtensionStep4}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="5." FontWeight="SemiBold"/>
                    <Run Text="{x:Static ui:Tr.ExtensionStep5}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
            <Ellipse Width="8" Height="8" Fill="{Binding ExtensionStatusColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ExtensionStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="CopiedText" Style="{StaticResource Muted}" Margin="2,6,0,0" Visibility="Collapsed"/>

        <Button HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Content="{x:Static ui:Tr.Done}" Padding="18,8" Margin="0,16,0,0"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
