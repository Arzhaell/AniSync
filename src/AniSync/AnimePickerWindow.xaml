<Window x:Class="AniSync.AnimePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AniSync.Ui"
        Title="{x:Static ui:Tr.PickWindowTitle}" Icon="Assets/AniSync.ico"
        Width="480" Height="560" MinHeight="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Static ui:Tr.PickTitle}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="DetectedText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <TextBox x:Name="SearchBox" Margin="0,0,96,0" PreviewKeyDown="SearchBox_KeyDown"
                     ToolTip="{x:Static ui:Tr.SearchTip}"/>
            <Button HorizontalAlignment="Right" Width="88" Style="{StaticResource BaseButton}" Content="{x:Static ui:Tr.Search}" Click="Search_Click"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,6,0,0"/>
            <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Results_DoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="8" Margin="0,0,0,6"
                                            Background="{StaticResource CardBrush}" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#35506F"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#16304A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="62" CornerRadius="6" Background="{StaticResource SubtleBrush}">
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{x:Static ui:Tr.Cancel}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="{x:Static ui:Tr.ThatOne}" Margin="8,0,0,0"
                    Padding="16,8" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
